{{- $is_powershell := eq (includeTemplate "is_powershell" . | trim) "true" -}}
{{- $is_wsl := eq (includeTemplate "is_wsl" . | trim) "true" -}}
{
  "env": {
    {{- if eq .claude.profile "copilot" }}
    "ANTHROPIC_BASE_URL": "http://localhost:4141",
    "ANTHROPIC_MODEL": "claude-opus-4.5",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "claude-opus-4.5",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "claude-sonnet-4.5",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "gpt-4.1-2025-04-14",
    "CLAUDE_CODE_SUBAGENT_MODEL": "claude-sonnet-4.5",
    {{- else if or (eq .claude.profile "cliproxy") (eq .claude.profile "vcliproxy") }}
    "ANTHROPIC_BASE_URL": "http://127.0.0.1:8317",
    "ANTHROPIC_AUTH_TOKEN": "{{ (bitwarden "item" "cliproxy-apikey").login.password }}",
    {{- if eq .claude.profile "vcliproxy" }}
    "ANTHROPIC_MODEL": "v/gpt-5.3-codex(xhigh)",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "v/gpt-5.3-codex(xhigh)",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "v/gpt-5.3-codex(high)",
    "CLAUDE_CODE_SUBAGENT_MODEL": "v/gpt-5.3-codex(high)",
    {{- else }}
    "ANTHROPIC_MODEL": "gpt-5.3-codex(xhigh)",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "gpt-5.3-codex(xhigh)",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "gpt-5.3-codex(high)",
    "CLAUDE_CODE_SUBAGENT_MODEL": "gpt-5.3-codex(high)",
    {{- end }}
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "gemini-2.5-flash-lite",
    {{- else if eq .claude.profile "vrouter"}}
    "ANTHROPIC_BASE_URL": "{{ (bitwarden "item" "vrouter-api-token").login.username }}",
    "ANTHROPIC_AUTH_TOKEN": "{{ (bitwarden "item" "vrouter-api-token").login.password }}",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "ag/claude-opus-4-5-thinking",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "ag/claude-sonnet-4-5-thinking",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "ag/gemini-2.5-flash-lite[1m]",
    "CLAUDE_CODE_SUBAGENT_MODEL": "ag/claude-sonnet-4-5-thinking",
    {{- else if eq .claude.profile "isrouter" }}
    "ANTHROPIC_BASE_URL": "{{ (bitwarden "item" "isrouter-api-token").login.username }}",
    "ANTHROPIC_AUTH_TOKEN": "{{ (bitwarden "item" "isrouter-api-token").login.password }}",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "gh/claude-opus-4.6",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "gh/claude-sonnet-4.5",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "gh/gpt-5-mini",
    "CLAUDE_CODE_SUBAGENT_MODEL": "gh/claude-sonnet-4.5",
    {{- end }}
    {{- if eq .claude.disableNonEssential true }}
    "DISABLE_NON_ESSENTIAL_MODEL_CALLS": "1",
    "DISABLE_TELEMETRY": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "DISABLE_BUG_COMMAND": "1",
    {{- end }}
    {{- /* Experimental */}}
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "API_TIMEOUT_MS": "600000",
    "EDITOR": "zed --wait",
    "VISUAL": "zed --wait",
    "DISABLE_ZOXIDE": "1"
  },
  "permissions": {
    {{- /* PERMISSIONS:START */}}
    "allow": [
      "Read({{ .chezmoi.homeDir }}/.claude/**)",
      "Read({{ .chezmoi.homeDir }}/.local/share/chezmoi/**)",
      "Read(//tmp/**)",
      "Edit(//tmp/**)",
      "Edit({{ .chezmoi.homeDir }}/.claude/**)",
      "Write(//tmp/**)",
      "Write({{ .chezmoi.homeDir }}/.claude/**)",
      "Bash(basename:*)",
      "Bash(cargo add:*)",
      "Bash(cargo build:*)",
      "Bash(cargo check:*)",
      "Bash(cargo clean:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo info:*)",
      "Bash(cargo fmt:*)",
      "Bash(cargo metadata:*)",
      "Bash(cargo remove:*)",
      "Bash(cargo search:*)",
      "Bash(cargo test:*)",
      "Bash(cargo tree:*)",
      "Bash(cargo update:*)",
      "Bash(cat:*)",
      "Bash(cd:*)",
      "Bash(claude --version:*)",
      "Bash(codex exec:*)",
      "Bash(cut:*)",
      "Bash(date:*)",
      "Bash(echo:*)",
      "Bash(file:*)",
      "Bash(grep:*)",
      "Bash(head:*)",
      "Bash(gh issue view:*)",
      "Bash(gh release list:*)",
      "Bash(gh release view:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git status:*)",
      "Bash(gofmt:*)",
      "Bash(go build:*)",
      "Bash(go test:*)",
      "Bash(go vet:*)",
      "Bash(ls:*)",
      "Bash(mkdir:*)",
      "Bash(npm info:*)",
      "Bash(npx tsc:*)",
      "Bash(pnpm add:*)",
      "Bash(pnpm build:*)",
      "Bash(pnpm i:*)",
      "Bash(pnpm install:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm run build:*)",
      "Bash(pwd:*)",
      "Bash(sort:*)",
      "Bash(strings:*)",
      "Bash(tree:*)",
      "Bash(uniq:*)",
      "Bash(wc:*)",
      "mcp__context7",
      "mcp__mcp-server-github",
      "mcp__playwright",
      "mcp__searxng",
      "Skill",
      "WebFetch"
    ],
    "deny": [
      "Bash(chezmoi apply:*)",
      "Bash(dd:*)",
      "Bash(fdisk:*)",
      "Bash(git checkout:*)",
      "Bash(git clean:*)",
      "Bash(git filter-branch:*)",
      "Bash(git filter-repo:*)",
      "Bash(git push:*)",
      "Bash(git reset:*)",
      "Bash(mount:*)",
      "Bash(parted:*)",
      "Bash(passwd:*)",
      "Bash(reboot:*)",
      "Bash(shred:*)",
      "Bash(shutdown:*)",
      "Bash(srm:*)",
      "Bash(sudo:*)",
      "Bash(truncate:*)",
      "Bash(umount:*)",
      "Bash(wipe:*)",
      "Bash(wipefs:*)",
      "WebSearch"
    ],
    "ask": [
      "Bash(chmod:*)",
      "Bash(chown:*)",
      "Bash(kill:*)",
      "Bash(killall:*)",
      "Bash(pkill:*)",
      "Bash(unlink:*)"
    ],
    "defaultMode": "bypassPermissions",
    "additionalDirectories": [
      "//tmp",
      "{{ .chezmoi.homeDir }}/.claude"
    ]
    {{- /* PERMISSIONS:END */}}
  },
  "model": "opus",
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
{{- if eq .chezmoi.os "darwin" }}
            "command": "bash -lc 'afplay /System/Library/Sounds/Ping.aiff'",
{{- else if $is_powershell }}
            "command": "pwsh -c \"[System.Media.SystemSounds]::Asterisk.Play()\"",
{{- else if $is_wsl }}
            "command": "bash -lc 'powershell.exe -NoProfile -Command \"[System.Media.SystemSounds]::Asterisk.Play(); Start-Sleep -Milliseconds 300\"'",
{{- else }}
            "command": "paplay /usr/share/sounds/freedesktop/stereo/complete.oga",
{{- end }}
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
{{- if eq .chezmoi.os "darwin" }}
            "command": "bash -lc 'afplay /System/Library/Sounds/Ping.aiff'",
{{- else if $is_powershell }}
            "command": "pwsh -c \"[System.Media.SystemSounds]::Asterisk.Play()\"",
{{- else if $is_wsl }}
            "command": "bash -lc 'powershell.exe -NoProfile -Command \"[System.Media.SystemSounds]::Asterisk.Play(); Start-Sleep -Milliseconds 300\"'",
{{- else }}
            "command": "paplay /usr/share/sounds/freedesktop/stereo/complete.oga",
{{- end }}
            "async": true
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
{{- if eq .chezmoi.os "windows" }}
            "command": "%USERPROFILE%\\.claude\\hooks\\agent_hooks_claude.exe pre-tool-use --deny-rust-allow --expect"
{{- else }}
            "command": "$HOME/.claude/hooks/agent_hooks_claude pre-tool-use --deny-rust-allow --expect"
{{- end }}
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
{{- if eq .chezmoi.os "windows" }}
            "command": "%USERPROFILE%\\.claude\\hooks\\agent_hooks_claude.exe pre-tool-use --check-package-manager --deny-destructive-find --deny-nul-redirect"
{{- else }}
            "command": "$HOME/.claude/hooks/agent_hooks_claude pre-tool-use --check-package-manager --deny-destructive-find"
{{- end }}
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
{{- if eq .chezmoi.os "windows" }}
            "command": "%USERPROFILE%\\.claude\\hooks\\agent_hooks_claude.exe permission-request --block-rm"
{{- else }}
            "command": "$HOME/.claude/hooks/agent_hooks_claude permission-request --block-rm"
{{- end }}
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
{{- if eq .chezmoi.os "windows" }}
    "command": "%USERPROFILE%\\.claude\\hooks\\claude_statusline.exe",
{{- else }}
    "command": "$HOME/.claude/hooks/claude_statusline",
{{- end }}
    "padding": 0
  },
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true,
    "context7@claude-plugins-official": true
  },
  "language": "日本語",
  "skipDangerousModePermissionPrompt": true,
  "defaultMode": "bypassPermissions"
}

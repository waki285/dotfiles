{
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      }
    }
  },
  "permission": {
    "read": {
      "*": "allow"
    },
    "grep": {
      "*": "allow"
    },
    "glob": {
      "*": "allow"
    },
    "bash": {
      "*": "allow"
    },
    "webfetch": "allow"
  },
  "$schema": "https://opencode.ai/config.json"
}

#:schema https://developers.openai.com/codex/config-schema.json

model = "gpt-5.5"
model_reasoning_effort = "xhigh"
plan_mode_reasoning_effort = "xhigh"
approvals_reviewer = "user"

sandbox_mode = "workspace-write"
network_access = true
web_search = "live" 

personality = "pragmatic"

suppress_unstable_features_warning = true

{{ if eq .chezmoi.os "darwin" -}}
notify = ["bash", "-lc", "afplay /System/Library/Sounds/Ping.aiff"]
{{- else if eq .chezmoi.os "windows" -}}
notify = ["pwsh", "-NoProfile", "-NonInteractive", "-File", "{{ joinPath .chezmoi.homeDir ".codex" "notify.ps1" | replace "\\" "/" }}"]
{{- else -}}
notify = ["paplay", "/usr/share/sounds/freedesktop/stereo/complete.oga"]
{{- end }}

[notice]
hide_rate_limit_model_nudge = true

[model_providers.rb]
name = "rb"
base_url = "{{ (bitwarden "item" "rbrouter").login.username }}/v1"
wire_api = "responses"
http_headers = { "X-Api-Key" = "{{ (bitwarden "item" "rbrouter").login.password }}" }

[model_providers.ym]
name = "OpenAI"
base_url = "{{ (bitwarden "item" "ymrouter").login.username }}/v1"
wire_api = "responses"
experimental_bearer_token = "{{ (bitwarden "item" "ymrouter").login.password }}"
http_headers = { "DKU-Verbose-Logs" = "1" }

[model_providers.szlb]
name = "OpenAI"
base_url = "{{ (bitwarden "item" "szlb").login.username }}/backend-api/codex"
wire_api = "responses"
experimental_bearer_token = "{{ (bitwardenFields "item" "szlb").apikey.value }}"
#supports_websockets = true

[sandbox_workspace_write]
network_access = true

{{ if eq .chezmoi.os "windows" -}}
[windows]
sandbox = "elevated"

[shell_environment_policy]
exclude = ["^LANG$", "^LC_.*$"]
{{- end }}

[profiles.ym]
model_provider = "ym"
service_tier = "fast"
chatgpt_base_url = "{{ (bitwarden "item" "ymrouter").login.username }}/backend-api"
#supports_websockets = true

[profiles.sz]
model_provider = "szlb"
service_tier = "fast"

[tui]
status_line = ["model-with-reasoning", "current-dir", "project-root", "git-branch", "context-usage", "weekly-limit", "context-window-size", "fast-mode"]
theme = "monokai-extended-origin"

[features]
default_mode_request_user_input = true
js_repl = true
memories = true
{{- if eq .chezmoi.os "windows" }}
unified_exec = true
{{- end }}
voice_transcription = true

[agents.explorer]
description = "Fast, authoritative codebase explorer for discovery and analysis. Use for locating files, symbols, and implementation details without making edits."
config_file = "agents/explorer.toml"

[mcp_servers.context7]
args = ["-y", "@upstash/context7-mcp"]
command = "npx"

[mcp_servers.markitdown]
args = ["run", "--rm", "-i", "mcp/markitdown:latest"]
command = "docker"

[mcp_servers.chrome-devtools]
type = "stdio"
command = "npx"
{{ if eq .chezmoi.os "windows" -}}
args = ["-y", "chrome-devtools-mcp@latest", "--browser-url=http://127.0.0.1:9222"]
{{- else -}}
args = ["-y", "chrome-devtools-mcp@latest"]
{{- end }}
description = "Chrome DevTools MCP: run performance traces, inspect the DOM, and perform real-time debugging of your web pages — useful for browser automation, end-to-end testing, and capturing page artifacts."

[mcp_servers.github]
url = "https://api.githubcopilot.com/mcp"
bearer_token_env_var = "GITHUB_MCP_API_TOKEN"

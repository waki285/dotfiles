{{- $searxngPort := includeTemplate "searxng_port" . | trim -}}
services:
  searxng:
    container_name: searxng
    image: docker.io/searxng/searxng:latest
    restart: unless-stopped
    # Bound to loopback only: this instance exists for the local MCP server,
    # not for the network.
    ports:
      - "127.0.0.1:{{ $searxngPort }}:8080"
    volumes:
      - ./config:/etc/searxng:rw
      - searxng-data:/var/cache/searxng:rw
    environment:
      SEARXNG_BASE_URL: "http://127.0.0.1:{{ $searxngPort }}/"
    logging:
      driver: json-file
      options:
        max-size: 1m
        max-file: 1

volumes:
  searxng-data:
